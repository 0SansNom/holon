// ReBAC authorization schema.

// Users, service accounts, agents, and groups share this principal type.
definition principal {
    relation member: principal
}

definition tenant {
    relation member: principal
}

definition workspace {
    relation parent_tenant: tenant
    relation viewer: principal | principal#member
    relation editor: principal | principal#member
    relation admin: principal | principal#member

    permission read = viewer + editor + admin
    permission write = editor + admin
    permission approve = admin
}

// Workspace and Project hierarchy definitions.
definition project {
    relation parent_workspace: workspace
    relation viewer: principal | principal#member
    relation editor: principal | principal#member
    relation admin: principal | principal#member

    permission read = viewer + editor + admin + parent_workspace->read
    permission write = editor + admin + parent_workspace->write
    permission approve = admin + parent_workspace->approve
}

definition object_type {
    relation parent_workspace: workspace
    relation parent_project: project

    permission read = parent_workspace->read + parent_project->read
    permission write = parent_workspace->write + parent_project->write
    permission approve = parent_workspace->approve + parent_project->approve
}

definition shared_property_type {
    relation parent_workspace: workspace
    relation parent_project: project

    permission read = parent_workspace->read + parent_project->read
    permission write = parent_workspace->write + parent_project->write
    permission approve = parent_workspace->approve + parent_project->approve
}

definition value_type {
    relation parent_workspace: workspace
    relation parent_project: project

    permission read = parent_workspace->read + parent_project->read
    permission write = parent_workspace->write + parent_project->write
    permission approve = parent_workspace->approve + parent_project->approve
}

definition relation_type {
    relation parent_workspace: workspace
    relation parent_project: project

    permission read = parent_workspace->read + parent_project->read
    permission write = parent_workspace->write + parent_project->write
    permission approve = parent_workspace->approve + parent_project->approve
}

definition application {
    relation parent_workspace: workspace
    relation parent_project: project

    permission read = parent_workspace->read + parent_project->read
    permission write = parent_workspace->write + parent_project->write
}

// Markings security labels.
definition marking {
    relation holder: principal
    relation admin: principal
    permission hold = holder + admin
    permission administer = admin
}
