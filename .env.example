# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# These are the values docker-compose.yml interpolates via ${VAR} substitution
# (R8.14: no secret in code/config/env in cleartext — this keeps them out of
# tracked source; a real secrets manager with rotation is a further step).
HOLON_JWT_SECRET=change-me
# Optional rotation map (overrides singular when set): kid1:secretA,kid2:secretB
# HOLON_JWT_SECRETS=
# HOLON_JWT_ACTIVE_KID=kid1
HOLON_SECRET_BACKEND=env
HOLON_SPICEDB_PRESHARED_KEY=change-me
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
# AWS_ACCESS_KEY_ID is not set here — docker-compose.yml hardcodes it to
# "holon" everywhere, matching MinIO's hardcoded MINIO_ROOT_USER (see the
# comment on that service). Only the secret half is configurable.
AWS_SECRET_ACCESS_KEY=change-me
# Must satisfy OpenSearch's password complexity check (8+ chars, upper/lower/digit/special).
OPENSEARCH_ADMIN_PASSWORD=change-me

# Phase 3, Intelligence Platform — real external API keys, not dev-only
# fixed values like the rest of this file. Get your own; never share these.
ANTHROPIC_API_KEY=change-me
# Only required if HOLON_EMBEDDING_PROVIDER=voyage (see docker-compose.yml).
VOYAGE_API_KEY=change-me

# OIDC (optional) — leave unset for demo secret login only.
# HOLON_OIDC_ISSUER=https://login.example.com/realms/holon
# HOLON_OIDC_CLIENT_ID=holon
# HOLON_OIDC_CLIENT_SECRET=vault:secret/data/holon#oidc_client_secret
# HOLON_OIDC_REDIRECT_URI=http://localhost:8001/oidc/callback
# HOLON_OIDC_SCOPES=openid profile email groups
# HOLON_OIDC_TENANT_CLAIM=tenant_id
# HOLON_OIDC_TENANT_GROUP_PREFIX=tenant:
# HOLON_OIDC_WORKSPACE_GROUP_PREFIX=workspace:
# HOLON_OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/objects
