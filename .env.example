# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# These are the values docker-compose.yml interpolates via ${VAR} substitution
# (R8.14: no secret in code/config/env in cleartext — this keeps them out of
# tracked source; a real secrets manager with rotation is a further step).
HOLON_JWT_SECRET=change-me
# Optional rotation map (overrides singular when set): kid1:secretA,kid2:secretB
# Values may be secret refs: env:NAME / vault:path#key / k8s:ns/name/key / aws:…
# HOLON_JWT_SECRETS=
# HOLON_JWT_ACTIVE_KID=kid1
# Optional RS256 (asymmetric). Generate with: make gen-jwt-rsa
# HOLON_JWT_ALG=RS256
# HOLON_JWT_PRIVATE_KEYS=
# HOLON_JWT_PUBLIC_KEYS=
# HOLON_JWT_REQUIRE_ASYMMETRIC=true  # production posture when using RS256
HOLON_SECRET_BACKEND=env
# Vault (when HOLON_SECRET_BACKEND=vault or vault: refs): VAULT_ADDR + VAULT_TOKEN
# or AppRole VAULT_ROLE_ID + VAULT_SECRET_ID
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
HOLON_SPICEDB_PRESHARED_KEY=change-me
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
# AWS_ACCESS_KEY_ID is not set here — docker-compose.yml hardcodes it to
# "holon" everywhere, matching MinIO's hardcoded MINIO_ROOT_USER (see the
# comment on that service). Only the secret half is configurable.
AWS_SECRET_ACCESS_KEY=change-me
# Must satisfy OpenSearch's password complexity check (8+ chars, upper/lower/digit/special).
OPENSEARCH_ADMIN_PASSWORD=change-me

# Local DX (compose default). Production: HOLON_ENV=production,
# set METRICS_TOKEN, CORS, mint allowlists.
# HOLON_ENV=
# Empty-instance admin (Identity) — required in every environment, dev
# included: there is no dev-login shortcut, local behaves the same as
# production. Set this to a real value before first boot.
HOLON_BOOTSTRAP_ADMIN_SECRET=change-me
# HOLON_BOOTSTRAP_ADMIN_LOCAL_NAME=admin
# Break-glass (restart Identity once, then unset):
# HOLON_BOOTSTRAP_ADMIN_RESET_SECRET=true
# HOLON_INTELLIGENCE_ENABLED=true
# HOLON_LLM_PROVIDER=anthropic  # set to `fake` for CI / no API spend
# HOLON_INTELLIGENCE_RPM=30
# HOLON_INTELLIGENCE_DAILY_TOKEN_QUOTA=200000
# HOLON_ALLOW_JOBLIB_MODELS=true   # local only — pickle/RCE; refused in prod posture
# HOLON_ALLOW_TOOL_PLUGIN_REGISTER=true  # local only — in-process plugins
# HOLON_TOOL_PLUGIN_ENTRY_PREFIXES=app.plugins.,app.tool_plugins.  # Intelligence register allowlist
# HOLON_METRICS_TOKEN=
# HOLON_SERVING_STORE_REQUIRE_MATERIALIZED=false
# HOLON_CORS_ORIGINS=http://localhost:5173,http://localhost:8004
# HOLON_OTLP_ENDPOINT=   # empty = tracing off (recommended for local compose)
# Per-service mint allowlists are set in docker-compose.yml (not here).
# HOLON_ALLOW_USER_JWT_MINT=true  # Identity only (compose sets this on identity)
# HOLON_MINTABLE_PRINCIPAL_URNS=  # required when HOLON_ENV=production

# Phase 3, Intelligence Platform — real external API keys, not dev-only
# fixed values like the rest of this file. Get your own; never share these.
ANTHROPIC_API_KEY=change-me
# Only required if HOLON_EMBEDDING_PROVIDER=voyage (see docker-compose.yml).
VOYAGE_API_KEY=change-me

# OIDC (optional) — leave unset for demo secret login only.
# HOLON_OIDC_ISSUER=https://login.example.com/realms/holon
# HOLON_OIDC_CLIENT_ID=holon
# HOLON_OIDC_CLIENT_SECRET=vault:secret/data/holon#oidc_client_secret
# HOLON_OIDC_REDIRECT_URI=http://localhost:8001/oidc/callback
# HOLON_OIDC_SCOPES=openid profile email groups
# HOLON_OIDC_TENANT_CLAIM=tenant_id
# HOLON_OIDC_TENANT_GROUP_PREFIX=tenant:
# HOLON_OIDC_WORKSPACE_GROUP_PREFIX=workspace:
# HOLON_OIDC_WORKSPACE_EDITOR_GROUP_PREFIX=workspace-editor:
# HOLON_OIDC_WORKSPACE_ADMIN_GROUP_PREFIX=workspace-admin:
# HOLON_OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/objects
